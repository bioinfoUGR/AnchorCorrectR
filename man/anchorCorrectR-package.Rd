\name{anchorCorrectR-package}
\alias{anchorCorrectR}
\alias{anchorCorrectR-package}
\docType{package}
\title{anchorCorrectR: Anchor-Based Batch Correction}
\description{
Anchor-based batch correction for gene expression matrices using replicate
samples observed across technical batches. Supports location-shift correction
(mean or median), ridge regression, and anchor-aware ComBat, plus assessment
and quality-control utilities.
}
\author{María Rivas-Torrubia, Ana Brescia-Zapata, Guillermo Barturen}
\keyword{package}
